datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEED_MORE_DOCS
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NEEDS_CHANGES
  BLOCKED
}

enum DocumentType {
  GST
  PAN
  BUSINESS_REGISTRATION
  SUSTAINABILITY_CERTIFICATE
  MANUFACTURING_PROOF
  BANK_PROOF
  AADHAR
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String? // Hashed password for credentials login
  emailVerified DateTime?
  image         String?
  phone         String?   // Buyer phone number collected during registration
  role          Role      @default(BUYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  seller        Seller?
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  wishlist      Wishlist?
  enquiries     Enquiry[]
  complaints    Complaint[]
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

// Temporary OTP storage for buyer email verification during registration
model OtpVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  otpHash   String   // SHA-256 hashed OTP for security
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Seller {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  businessType       String // e.g. Manufacturer, Brand, Supplier
  description        String?
  logoUrl            String?
  website            String?
  gstNumber          String?
  panNumber          String?
  declaredRevenue    String? // Estimated/Annual revenue declared by the seller during onboarding
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectionReason    String?
  trustScore         Float              @default(0)
  badges             String[] // Array of badge labels (e.g. "Verified Business", "Verified Sustainable Manufacturer")
  phone              String?
  ownerName          String?
  founderName        String?
  aadharNumber       String?
  factoryAddress     String?
  pickupAddress      String?
  companyAddress     String?
  bankAccountNo      String?
  bankName           String?
  bankIfsc           String?
  bankProofUrl       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  documents      SellerDocument[]
  products       Product[]
  reviews        Review[] // Direct reviews of the seller
  payoutRequests PayoutRequest[]
  orders         Order[]
}

model SellerDocument {
  id         String       @id @default(cuid())
  sellerId   String
  seller     Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type       DocumentType
  fileUrl    String
  fileName   String
  uploadedAt DateTime     @default(now())
}

model Certification {
  id          String                 @id @default(cuid())
  name        String // e.g. "GOTS Organic Textiles"
  code        String                 @unique // e.g. "GOTS"
  logoUrl     String?
  description String?
  products    ProductCertification[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
}

model Product {
  id                   String   @id @default(cuid())
  sellerId             String
  seller               Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId           String
  category             Category @relation(fields: [categoryId], references: [id])
  name                 String
  slug                 String   @unique
  description          String
  shortDescription     String?
  price                Float
  wholesalePrice       Float?
  originalPrice        Float?
  moq                  Int      @default(1)
  unit                 String   @default("piece") // e.g. piece, kg, box
  bulkPriceSlabs       Json?    // [{min: 100, price: 150}]
  tierDiscounts        Json?    // [{minQuantity: 10, discountType: "PERCENTAGE", discountValue: 15}]
  buyXGetYOffer        Json?    // {enabled: true, buyQuantity: 2, getQuantity: 1, maxFreeQuantity: 5, startDate: "2026-07-01", endDate: "2026-12-31"}
  materialUsed         String?
  deliveryTime         String?
  returnEligibility    String?
  stock                Int      @default(0)
  productDate          DateTime @default(now())
  sustainabilityScore  Int      @default(50) // 1-100 score
  sustainabilityDetail String? // Explains why it's eco-friendly
  status               ProductStatus @default(DRAFT)
  isApproved           Boolean  @default(false)
  isArchived           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  images         ProductImage[]
  certifications ProductCertification[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  reviews        Review[]
  enquiries      Enquiry[]
}

model ProductCertification {
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@id([productId, certificationId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  sellerId    String?
  seller      Seller?     @relation(fields: [sellerId], references: [id])
  addressId   String
  address     Address     @relation(fields: [addressId], references: [id])
  totalAmount Float
  paymentGroupId String?  // To group orders from different sellers paid together
  status      OrderStatus @default(PLACED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items      OrderItem[]
  payment    Payment?
  timeline   OrderTimeline[]
  complaints Complaint[]
}

model OrderTimeline {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  description String
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float // Lock in price at checkout
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  street     String
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean @default(false)
  orders     Order[]
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  String?
  seller    Seller?  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  rating    Int // 1 to 5
  comment   String?
  imageUrls String[] // Images attached to product review
  createdAt DateTime @default(now())
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId   String
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  amount            Float
  currency          String        @default("INR")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  details    String?
  adminEmail String
  createdAt  DateTime @default(now())
}

enum PayoutStatus {
  PENDING
  PARTIALLY_PAID
  APPROVED
  REJECTED
  PAID
  SETTLED
  ON_HOLD
}

model PayoutRequest {
  id                String       @id @default(cuid())
  sellerId          String
  seller            Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount            Float
  remainingAmount   Float?
  status            PayoutStatus @default(PENDING)
  requestedAt       DateTime     @default(now())
  settledAt         DateTime?
  adminEmail        String?
  notes             String?
  isUrgent          Boolean      @default(false)
  reason            String?
  transactionId     String?
  paymentMethod     String       @default("BANK")
  bankDetails       Json?
  upiDetails        Json?
  approvedAt        DateTime?
  paidAt            DateTime?
  rejectedReason    String?
  settlementHistory Json?
}

model Enquiry {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId      String?
  buyer        User?     @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  quantity     Int
  targetPrice  Float?
  location     String
  expectedDate DateTime?
  name         String
  email        String
  phone        String
  message      String?
  status       String    @default("NEW") // NEW, VIEWED, RESPONDED, CLOSED, CANCELLED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Complaint {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  subject        String
  message        String
  proofUrl       String?
  status         String   @default("PENDING") // PENDING, UNDER_REVIEW, RESOLVED, REJECTED
  sellerResponse String?
  sellerProofUrl String?
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content     String
  isRead      Boolean  @default(false)
  isDelivered Boolean  @default(true)
  createdAt   DateTime @default(now())
  attachments Json?
  reference   Json?
}

model SystemCredential {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

